FROM python:3.11-slim
ENV QT_QPA_PLATFORM=linux/arm/v7 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# ============================================================================
# CRITICAL: Install system dependencies BEFORE pip install
# This is the KEY to fixing "libavcodec.so: cannot open shared object file"
# Using -dev packages (which auto-include runtime libs) for both build & runtime
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    # OpenCV/image processing dependencies
    libopenblas-dev \
    libblas-dev \
    liblapack-dev \
    libopenjp2-7 \
    libtiff5-dev \
    libsm6 \
    libxext6 \
    libxrender-dev \
    pkg-config \
    \
    # Image format support
    libpng-dev \
    libjpeg-dev \
    libfreetype6 \
    libharfbuzz0b \
    libwebp-dev \
    \
    # Audio/Video codec libraries (dev packages include runtime libs)
    libavcodec-dev \
    libavformat-dev \
    libavutil-dev \
    libswscale-dev \
    \
    # Additional tools
    libgl1 \
    libxcb-glx0 \
    curl \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /usr/share/man/* /usr/share/doc/* /usr/share/locale/*

COPY requirements.txt .
RUN pip install --no-cache-dir \
    --index-url https://www.piwheels.org/simple \
    --extra-index-url https://pypi.org/simple \
    --only-binary=:all: \
    -r requirements.txt

COPY app.py .
RUN chmod +x app.py && mkdir -p uploads tmp

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python3 -c "import cv2; print('OpenCV OK:', cv2.__version__)" || exit 1

ENTRYPOINT ["./app.py"]
