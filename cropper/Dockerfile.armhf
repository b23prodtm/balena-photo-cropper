# cropper/Dockerfile - Python 3.11-slim avec support multi-platform
# FIX: System dependencies installed BEFORE pip (fixes libpng16.so.16 error)

FROM python:3.11-slim
ENV QT_QPA_PLATFORM=linux/arm/v7

WORKDIR /app

# ============================================================================
# CRITICAL: Install system dependencies BEFORE pip install
# This is the KEY to fixing "libpng16.so.16: cannot open shared object file"
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    libopenblas-dev \
    libblas-dev \
    liblapack-dev \
    libopenjp2-7 \
    libtiff5-dev \
    libsm6 \
    libxext6 \
    libxrender-dev \
    pkg-config \
    libpng-dev \
    libjpeg-dev \
    libfreetype6 \
    libharfbuzz0b \
    libwebp-dev \
    libgl1 \
    libxcb-glx0 \
    curl \
    \
    # OpenCV video / ffmpeg runtime
    ffmpeg \
    libavcodec59 \
    libavformat59 \
    libavutil57 \
    libswscale6 \
    \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip & build tools
#RUN pip install --no-cache-dir --upgrade pip wheel setuptools

# Copy requirements
COPY requirements.txt .

# Install Python packages
RUN pip install --no-cache-dir \
    -r requirements.txt

# Copy application
COPY app.py .
COPY . .

RUN chmod +x app.py

# Create upload directories
RUN mkdir -p uploads tmp

EXPOSE 5000

# Health check - verify cv2 imports correctly
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python3 -c "import cv2; print('OpenCV OK:', cv2.__version__)" || exit 1

# Run Flask app
ENTRYPOINT ["./app.py"]
