# Stage 1: Builder (with all dev deps)
FROM python:3.11-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc g++ python3-dev \
    libopenblas-dev libblas-dev liblapack-dev libopenjp2-7 \
    libtiff5-dev libsm6 libxext6 libxrender-dev pkg-config \
    libpng-dev libjpeg-dev libfreetype6-dev libharfbuzz-dev libwebp-dev \
    libavcodec-dev libavformat-dev libavutil-dev libswscale-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY requirements.txt .
RUN pip install --user --no-cache-dir -r requirements.txt

# Stage 2: Runtime (minimal)
FROM python:3.11-slim

ENV QT_QPA_PLATFORM=%%PLATFORM%% \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libopenblas0 libblas3 liblapack3 libopenjp2-7 libtiff5 libsm6 libxext6 \
    libxrender1 libpng16-16 libjpeg62-turbo libfreetype6 libharfbuzz0b libwebp7 \
    libavcodec59 libavformat59 libavutil57 libswscale6 libgl1 libxcb-glx0 ffmpeg curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy pre-built Python packages from builder stage
COPY --from=builder /root/.local /root/.local
ENV PATH=/root/.local/bin:$PATH

COPY app.py .
RUN chmod +x app.py && mkdir -p uploads tmp && \
    python3 -c "import cv2; print('OpenCV OK:', cv2.__version__)" || exit 1

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python3 -c "import cv2; print('OpenCV OK')" || exit 1

ENTRYPOINT ["./app.py"]
