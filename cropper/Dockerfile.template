# Stage 1: Builder
FROM alpine:3.19 AS builder

RUN apk add --no-cache \
    python3 \
    py3-pip \
    py3-opencv \
    py3-numpy \
    py3-pillow

WORKDIR /build
COPY requirements.txt .
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

# Stage 2: Runtime (minimal - Alpine)
FROM alpine:3.19

ENV QT_QPA_PLATFORM=%%PLATFORM%% \
    PIP_NO_CACHE_DIR=1 \
    PATH=/root/.local/bin:$PATH

RUN apk add --no-cache \
    python3 \
    py3-opencv \
    py3-numpy \
    py3-pillow \
    ffmpeg

WORKDIR /app

# Copy pre-built Python packages from builder stage
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
# Copy app code
COPY --from=builder /build /app

COPY . .

RUN chmod +x app.py && mkdir -p uploads tmp && \
    python3 -c "import cv2, numpy, pypdfium2; from PIL import Image; print('OpenCV OK:', cv2.__version__); print('All deps OK')" || exit 1

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python3 -c "import cv2, numpy, pypdfium2; from PIL import Image; print('OpenCV OK:', cv2.__version__)" || exit 1

ENTRYPOINT ["./app.py"]
