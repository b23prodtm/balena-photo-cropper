FROM alpine:3.19

RUN apk add --no-cache \
    python3 \
    py3-pip \
    py3-opencv \
    py3-numpy \
    py3-pillow \
    ffmpeg

WORKDIR /app
COPY requirements.txt .

# Create and use venv (PEP 668-safe)
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

COPY . .

RUN chmod +x app.py && mkdir -p uploads tmp && \
   python3 -c "import cv2, numpy, pypdfium2; from PIL import Image; print('OpenCV OK:', cv2.__version__); print('All deps OK')"

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python3 -c "import cv2, numpy, pypdfium2; from PIL import Image; print('OpenCV OK:', cv2.__version__); print('All deps OK')"

CMD ["python3", "app.py"]