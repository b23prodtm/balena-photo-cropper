# cropper/Dockerfile - Python 3.11-slim avec support multi-platform
# FIX: System dependencies installed BEFORE pip (fixes libpng16.so.16 error)

FROM python:3.11-slim
ENV QT_QPA_PLATFORM=linux/arm64

WORKDIR /app

# ============================================================================
# CRITICAL: Install system dependencies BEFORE pip install
# This is the KEY to fixing "libpng16.so.16: cannot open shared object file"
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    libopenblas-dev \
    libblas-dev \
    liblapack-dev \
    libopenjp2-7 \
    libtiff6 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libpng16-16 \
    libjpeg62-turbo \
    libfreetype6 \
    libharfbuzz0b \
    libwebp7 \
    libgl1 \
    libxcb1 \
    curl \
    ffmpeg \
    libavcodec59 \
    libavformat59 \
    libavutil57 \
    libswscale6 \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip & build tools
#RUN pip install --no-cache-dir --upgrade pip wheel setuptools

# Copy requirements
COPY requirements.txt .

# Install Python packages
# --prefer-binary: avoid recompilation on ARM
# piwheels: pre-compiled wheels for Raspberry Pi (arm/v7)
RUN pip install --no-cache-dir \
    --index-url https://www.piwheels.org/simple \
    --extra-index-url https://pypi.org/simple \
    --only-binary=:all: \
    -r requirements.txt

# Copy application
COPY app.py .
COPY . .

RUN chmod +x app.py

# Create upload directories
RUN mkdir -p uploads tmp

EXPOSE 5000

# Health check - verify cv2 imports correctly
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python3 -c "import cv2; print('OpenCV OK:', cv2.__version__)" || exit 1

# Run Flask app
ENTRYPOINT ["./app.py"]
