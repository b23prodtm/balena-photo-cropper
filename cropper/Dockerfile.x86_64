# Dockerfile for AMD64 (x86_64) - Local development
FROM python:3.11-slim

ENV QT_QPA_PLATFORM=linux/amd64 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# ============================================================================
# CRITICAL: Install system dependencies BEFORE pip install
# This prevents "cannot open shared object file" errors for PyMuPDF/OpenCV
# Added libavcodec and related codec libraries for PyMuPDF/FFmpeg on x86_64
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    # OpenCV/image processing dependencies
    libopenblas-dev \
    libblas-dev \
    liblapack-dev \
    libopenjp2-7 \
    libtiff5-dev \
    libsm6 \
    libxext6 \
    libxrender-dev \
    pkg-config \
    \
    # Image format support (x86_64-available packages)
    libpng-dev \
    libjpeg-dev \
    libfreetype6 \
    libharfbuzz0b \
    libwebp-dev \
    \
    # Audio/Video codec libraries (REQUIRED for PyMuPDF - FIX for libavcodec.so error)
    libavcodec-dev \
    libavformat-dev \
    libavutil-dev \
    libswscale-dev \
    \
    # Additional tools
    libgl1 \
    libxcb-glx0 \
    curl \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /usr/share/man/* /usr/share/doc/* /usr/share/locale/*

# Prepare Python environment
RUN pip install --no-cache-dir --upgrade pip wheel setuptools

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py .
RUN chmod +x app.py && mkdir -p uploads tmp

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python3 -c "import cv2; import numpy; import fitz; print('All deps OK')" || exit 1

CMD ["python3", "app.py"]
