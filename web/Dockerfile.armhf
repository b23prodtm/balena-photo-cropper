FROM php:8.4-fpm-alpine

# Install dependencies for MariaDB, GD, etc.
RUN apk add --no-cache \
    mariadb-connector-c-dev \
    freetype-dev \
    libpng-dev \
    libzip-dev \
    oniguruma-dev \
    icu-dev \
    icu-data-full \
    tzdata \
    git \
    unzip \
    libjpeg-turbo-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        pdo \
        pdo_mysql \
        mbstring \
        intl \
        gd \
        zip \
        opcache

# System dependencies
RUN apk add --no-cache \
    bash \
    curl \
    netcat-openbsd \
    php84-intl \
    imagemagick-dev \
    shadow


# Copy PHP configuration
COPY etc/php.ini /usr/local/etc/php/php.ini
COPY etc/php-fpm.conf /usr/local/etc/php-fpm.d/www.conf

# Install Composer
RUN curl -sS https://getcomposer.org/installer | php -- \
    --install-dir=/usr/local/bin --filename=composer

# --- SECURE SETUP ---
# 1. Create project in /var/www/cakephp
WORKDIR /var/www/cakephp

# Copy application source
COPY . .

# Install CakePHP dependencies (if composer.json exists)
RUN if [ -f composer.json ]; then \
        composer install --no-dev --optimize-autoloader --no-interaction; \
    fi

# 2. Fix permissions (FPM runs as www-data)
RUN mkdir -p app/tmp && mkdir -p app/logs && \
    chown -R www-data:www-data . && \
    chmod -R 775 app/tmp && \
    chmod -R 775 app/logs && \
    # 3. Configure PHP-FPM for CakePHP
    echo "php_admin_value[error_log] = /var/www/cakephp/app/logs/php-fpm.log" >> /usr/local/etc/php-fpm.d/www.conf && \
    echo "php_admin_flag[log_errors] = on" >> /usr/local/etc/php-fpm.d/www.conf


RUN \
# BUILDKIT BEGIN
#  --mount=type=secret,id=mysql_password,target=/run/secrets/MYSQL_PASSWORD \
# BUILDKIT END
 if [ -f /run/secrets/MYSQL_PASSWORD ]; then \
        export MYSQL_PASSWORD=$(cat /run/secrets/MYSQL_PASSWORD); \
        echo "Secret loaded"; \
    fi

EXPOSE 9000

# Health check - verify PHP-FPM is working
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD php-fpm -t || exit 1

COPY scripts/wait-for-it.sh /wait-for-it.sh
RUN chmod 755 /wait-for-it.sh

CMD ["php-fpm", "-F"]
