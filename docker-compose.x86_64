version: '2.1'

services:
  # Nginx - Reverse proxy with SSL (all config baked into image)
  nginx:
    build:
      context: ./nginx
      dockerfile: Dockerfile.x86_64
    ports:
    - "8080:80"    # HTTP redirect
    - "8443:443"    # HTTPS
    mem_limit: 64m
    mem_reservation: 32m
    restart: unless-stopped
    # PR #9: attend que web soit prêt avant de servir
    command: ["/wait-for-it.sh", "web", "9000"]
### BUILDKIT BEGIN    secrets:
      - SSL_KEY
      - SSL_CRT
### BUILDKIT END    depends_on:
      - web
      - cropper
    networks:
      - cakephp-network

  # Web Service - PHP-FPM CakePHP
  web:
    build:
      context: ./web
      dockerfile: Dockerfile.x86_64
    environment:
      PHP_FPM_PM: ondemand
      PHP_FPM_MAX_CHILDREN: 2
      PHP_FPM_MAX_REQUESTS: 100
      DB_HOST: db
      DB_NAME: cake_db
      DB_USER: cake_user
      # Runtime
      FLASK_ENV: production
      PYTHONUNBUFFERED: "1"
      QT_QPA_PLATFORM: offscreen
      
      # Configuration
      LOG_LEVEL: info
      MAX_FILE_SIZE: "100M"
      ALLOWED_FORMATS: "jpg,jpeg,png,gif,webp"
      
      # Performance
      WORKERS: "4"
      TIMEOUT: "30"
    mem_limit: 128m
    mem_reservation: 64m
    restart: unless-stopped
    # PR #9: attend que cropper Flask soit ready
    command: ["/bin/sh", "-c", "/wait-for-it.sh cropper 5000 sh -c '/wait-for-it.sh db 3306 php-fpm -F'"]
### BUILDKIT BEGIN    secrets:
      - MYSQL_PASSWORD
### BUILDKIT END    volumes:
      - web_data:/var/www/html
      - cropper_uploads:/app/uploads
      - cropper_cache:/tmp
    networks:
      - cakephp-network

  # --- MariaDB ---
  mysqldb:
    build:
      context: ./mysqldb
      dockerfile: Dockerfile.x86_64
    ports:
      - "3306:3306"
    environment:
      MYSQL_DATABASE: cake_db
      MYSQL_USER: cake_user
### BUILDKIT BEGIN    secrets:
      - MYSQL_PASSWORD
      - MYSQL_ROOT_PASSWORD
### BUILDKIT END    volumes:
      - db_data:/var/lib/mysql
      - db_init:/docker-entrypoint-initdb.d
    networks:
      cakephp-network:
        aliases:
          - db

  cropper:
    build:
      context: ./cropper
      dockerfile: Dockerfile.x86_64
    ports:
      - "5000:5000"
    environment:
      HEADLESS_MODE: true
    volumes:
      - 'cropper-data:/data'
    mem_limit: 450m
    mem_reservation: 200m
    restart: unless-stopped
    networks:
      - cakephp-network

# Volumes - ONLY named volumes (no bind mounts for Balena Cloud compatibility)
volumes:
  cropper-data:
    driver: local
  cakephp_data:
    driver: local
  db_data:
    driver: local
  db_init:
    driver: local
  redis_data:
    driver: local
  cropper_uploads:
    driver: local
  cropper_cache:
    driver: local
  web_data:
    driver: local

### BUILDKIT BEGINsecrets:
  SSL_KEY:
    file: ./.balena/secrets/ssl_key
  SSL_CRT:
    file: ./.balena/secrets/ssl_crt
  MYSQL_PASSWORD:
    file: ./.balena/secrets/mysql_password
  MYSQL_ROOT_PASSWORD:
    file: ./.balena/secrets/mysql_root_password
### BUILDKIT END
networks:
  cakephp-network:
    driver: bridge
