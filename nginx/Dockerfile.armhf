# services/nginx/Dockerfile - Nginx with explicit multi-platform support
FROM nginx:1.27-alpine

# Install curl for health checks and openssl for certificate generation
RUN apk add --no-cache \
    curl \
    bash \
    netcat-openbsd \
    openssl

# Copy custom nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Create web root and SSL directory
RUN mkdir -p /var/www/html && mkdir -p /etc/nginx/conf.d && mkdir -p /etc/nginx/ssl

# Copy entrypoint and wait-for-it scripts
COPY scripts/entrypoint.sh /entrypoint.sh
COPY scripts/wait-for-it.sh /wait-for-it.sh
COPY scripts/verify-secrets.sh /usr/local/bin/verify-secrets.sh
RUN chmod 755 /entrypoint.sh /wait-for-it.sh /usr/local/bin/verify-secrets.sh

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost/health 2>/dev/null || exit 1

COPY scripts/wait-for-it.sh /wait-for-it.sh
RUN chmod 755 /wait-for-it.sh



# Mount SSL secrets at build time (balena Cloud: provided via .balena/balena.yml)
RUN \
### BUILDKIT BEGIN
    --mount=type=secret,id=ssl_key,target=/run/secrets/ssl_key \
    --mount=type=secret,id=ssl_crt,target=/run/secrets/ssl_crt \
    ### BUILDKIT END
    mkdir -p /etc/nginx/ssl && \
    if [ -f /run/secrets/ssl_key ] && [ -s /run/secrets/ssl_key ]; then \
        cp /run/secrets/ssl_key /etc/nginx/ssl/server.key; \
        cp /run/secrets/ssl_crt /etc/nginx/ssl/server.crt; \
    fi

# Expose HTTP and HTTPS ports
EXPOSE 80 443

# Use entrypoint script for SSL certificate handling
ENTRYPOINT ["/bin/sh", "-lc", "/usr/local/bin/verify-secrets.sh nginx; exec /entrypoint.sh"]
