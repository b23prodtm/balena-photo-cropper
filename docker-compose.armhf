# Mandatory for Balena Cloud Services compatibility
version: '2.1'

services:
  # Nginx - Reverse proxy with SSL (all config baked into image)
  nginx:
    build:
      context: ./nginx
      dockerfile: Dockerfile.armhf
# BUILDKIT BEGIN
# secrets:
# - SSL_CRT
# - SSL_KEY
# BUILDKIT END
    ports:
    - "8080:80"    # HTTP redirect
    - "8443:443"    # HTTPS
    mem_limit: 64m
    mem_reservation: 32m
    environment:
      SSL_CRT_FILE: /run/secrets/SSL_CRT
      SSL_KEY_FILE: /run/secrets/SSL_KEY
    restart: unless-stopped
    depends_on:
      - web
      - cropper
    volumes:
      - web_data:/var/www/html:ro
    networks:
      - cakephp-network

  # Web Service - PHP-FPM CakePHP
  init-web:
    build:
      context: ./web
      dockerfile: Dockerfile.armhf
    restart: "no"
    command:
      - /bin/sh
      - -c
      - |
        if [ ! -f /var/www/html/app/webroot/index.php ]; then
          echo "Initializing CakePHP volume..."

          cp -a /var/www/cakephp/. /var/www/html/

          chown -R www-data:www-data /var/www/html

          echo "CakePHP initialized"
        else
          echo "CakePHP already initialized"
        fi
    volumes:
      - web_data:/var/www/html
    networks:
      - cakephp-network
  web:
    build:
      context: ./web
      dockerfile: Dockerfile.armhf
# BUILDKIT BEGIN
# secrets:
# - MYSQL_PASSWORD
# - SECURITY_SALT
# BUILDKIT END
    environment:
      DEBUG: "true"
      APP_DEFAULT_TIMEZONE: Europe/Paris
      PHP_FPM_PM: ondemand
      PHP_FPM_MAX_CHILDREN: 2
      PHP_FPM_MAX_REQUESTS: 100
      DB_HOST: mysqldb
      DB_NAME: cake_db
      DB_USER: cake_user
      # Runtime
      FLASK_ENV: production
      PYTHONUNBUFFERED: "1"
      QT_QPA_PLATFORM: offscreen
      
      # Configuration
      LOG_LEVEL: info
      MAX_FILE_SIZE: "100M"
      ALLOWED_FORMATS: "jpg,jpeg,png,gif,webp"
      
      # Performance
      WORKERS: "4"
      TIMEOUT: "30"      
      MYSQL_PASSWORD_FILE: /run/secrets/MYSQL_PASSWORD
      SECURITY_SALT_FILE: /run/secrets/SECURITY_SALT_FILE
    mem_limit: 128m
    mem_reservation: 64m
    restart: unless-stopped
    depends_on:
      - init-web
      - cropper
      - mysqldb
    # PR #9: attend que cropper Flask soit ready
    command:
      - /bin/sh
      - -c
      - |
        /wait-for-it.sh cropper 5000
        /wait-for-it.sh mysqldb 3306

        until [ -f /var/www/html/app/webroot/index.php ]; do
          echo "Waiting for CakePHP initialization..."
          sleep 1
        done

        exec php-fpm -F
    volumes:
      - web_data:/var/www/html
      - cropper_uploads:/app/uploads
      - cropper_cache:/tmp
    networks:
      - cakephp-network

  # --- MariaDB ---
  mysqldb:
    build:
      context: ./mysqldb
      dockerfile: Dockerfile.armhf
# BUILDKIT BEGIN
# secrets:
# - MYSQL_PASSWORD
# - MYSQL_ROOT_PASSWORD
# BUILDKIT END
    ports:
      - "3306:3306"
    environment:
      MYSQL_DATABASE: cake_db
      MYSQL_USER: cake_user
      MYSQL_PASSWORD_FILE: /run/secrets/MYSQL_PASSWORD
      MYSQL_ROOT_PASSWORD_FILE: /run/secrets/MYSQL_ROOT_PASSWORD
    volumes:
      - db_data:/var/lib/mysql
      - db_init:/docker-entrypoint-initdb.d
    networks:
      - cakephp-network

  cropper:
    build:
      context: ./cropper
      dockerfile: Dockerfile.armhf
    ports:
      - "5000:5000"
    environment:
      HEADLESS_MODE: true
    volumes:
      - 'cropper-data:/data'
    mem_limit: 450m
    mem_reservation: 200m
    restart: unless-stopped
    networks:
      - cakephp-network

# Volumes - ONLY named volumes (no bind mounts for Balena Cloud compatibility)
volumes:
  cropper-data:
    driver: local
  db_data:
    driver: local
  db_init:
    driver: local
  redis_data:
    driver: local
  cropper_uploads:
    driver: local
  cropper_cache:
    driver: local
  web_data:
    driver: local

networks:
  cakephp-network:
    driver: bridge
# BUILDKIT BEGIN
# secrets:
# MYSQL_PASSWORD:
# file: .balena/secrets/mysql_password
# MYSQL_ROOT_PASSWORD:
# file: .balena/secrets/mysql_root_password
# SSL_CRT:
# file: .balena/secrets/ssl_crt
# SSL_KEY:
# file: .balena/secrets/ssl_keycrt
# SECURITY_SALT:
# file: .balena/secrets/security_salt
# BUILDKIT END