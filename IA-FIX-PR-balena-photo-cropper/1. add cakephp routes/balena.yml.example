# balena.yml - Configuration Balena Cloud pour photo-cropper

version: '3.8'

services:
  # Reverse proxy Nginx
  nginx:
    image: balena/rpi-nginx:latest
    ports:
      - "80:80"
    volumes:
      - ./services/nginx/conf.d:/etc/nginx/conf.d:ro
    cap_add:
      - SYS_PTRACE
    environment:
      RESIN_MACHINE_NAME: "photo-cropper"
    networks:
      - photo-cropper

  # Service Web CakePHP3 + PHP-FPM
  web:
    image: balena/rpi-php:7.4-fpm
    volumes:
      - ./services/web:/var/www/html
    cap_add:
      - SYS_PTRACE
    environment:
      # Application
      APP_NAME: "Photo Cropper"
      CROPPER_SERVICE_URL: "http://cropper:5000"
      
      # Database
      DB_DRIVER: Mysql
      DB_HOST: db
      DB_PORT: "3306"
      DB_USERNAME: cropper_user
      DB_PASSWORD: ${DB_PASSWORD}
      DB_DATABASE: photo_cropper
      
      # PHP settings
      MEMORY_LIMIT: "256M"
      UPLOAD_MAX_FILESIZE: "100M"
      POST_MAX_SIZE: "100M"
      
      # Logging
      LOG_LEVEL: "info"
    networks:
      - photo-cropper

  # Service Cropper - Python OpenCV
  cropper:
    image: balena/rpi-python:3.11
    build:
      context: ./services/cropper
      dockerfile: Dockerfile
    cap_add:
      - SYS_PTRACE
    volumes:
      - cropper_uploads:/app/uploads
      - cropper_cache:/tmp
    environment:
      # Runtime
      FLASK_ENV: production
      PYTHONUNBUFFERED: "1"
      
      # Configuration
      LOG_LEVEL: info
      MAX_FILE_SIZE: "100M"
      ALLOWED_FORMATS: "jpg,jpeg,png,gif,webp"
      
      # Performance
      WORKERS: "4"
      TIMEOUT: "30"
    networks:
      - photo-cropper

  # Database MySQL
  db:
    image: balena/rpi-mysql:5.7
    volumes:
      - db_data:/var/lib/mysql
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
      MYSQL_DATABASE: photo_cropper
      MYSQL_USER: cropper_user
      MYSQL_PASSWORD: ${DB_PASSWORD}
    networks:
      - photo-cropper

# Volumes pour persistance
volumes:
  db_data:
    driver: local
  cropper_uploads:
    driver: local
  cropper_cache:
    driver: local

# Network interne
networks:
  photo-cropper:
    driver: bridge

---
# balena.yml - Fleet Configuration Variables

# Note: Configure ces variables dans le Dashboard balena sous :
# Fleet Configuration → Environment Variables

# **REQUIRED - Base de données**
DB_PASSWORD: "secure-password-change-me"
MYSQL_ROOT_PASSWORD: "root-secure-password"

# **OPTIONAL - Optimization**
RESIN_HOST_CONFIG_gpu_mem: "128"
RESIN_HOST_CONFIG_arm_freq: "1200"

# **OPTIONAL - Balena Supervisor**
SUPERVISOR_DELTA: "1"
SUPERVISOR_DELTA_REQUEST_TIMEOUT: "30000"
SUPERVISOR_POLL_INTERVAL: "60000"

# **DEBUG - Pour développement local**
# DEBUG: "1"
# FLASK_DEBUG: "0"
